# Brevo transactional email — server-side only.
# Create/edit an API key at https://app.brevo.com/settings/keys/api and give it
# "Transactional email" permission (or Full access). Never prefix this with
# VITE_ — that would expose the secret in the browser bundle.
BREVO_API_KEY=your_brevo_api_key_here

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=urvashisaini0723@gmail.com

# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs).
CONTACT_FROM_EMAIL=urvashisaini0723@gmail.com
CONTACT_FROM_NAME=Urvashi Saini Portfolio

# Comma-separated browser origins allowed to POST to /api/contact.
# On Render include the Vercel frontend URL (wildcards are supported).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://urvashi-portfolio-tawny.vercel.app,https://urvashi-portfolio-*.vercel.app

# Optional: port for `npm start` (defaults to 3000).
# PORT=3000

# Frontend-only setting (safe to expose). Leave empty for same-origin requests.
# Set this on Vercel to the Render API URL. Keep it commented locally so the
# Vite dev server uses its own /api/contact middleware.
# VITE_API_BASE_URL=https://urvashi-portfolio-api.onrender.com
